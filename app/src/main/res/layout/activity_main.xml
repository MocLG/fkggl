<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:layout_marginBottom="16dp" />

        <!-- ===================== encode ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_encode"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_pick_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_file" />

        <TextView
            android:id="@+id/txt_encode_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="backup.tar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_part_size"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Part size: 500 MB" />

            <Button
                android:id="@+id/btn_part_size"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_pick_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_folder" />

        <TextView
            android:id="@+id/txt_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="Downloads" />

        <Button
            android:id="@+id/btn_encode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/encode" />

        <TextView
            android:id="@+id/table_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/parts_header"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginTop="8dp" />

        <TableLayout
            android:id="@+id/tbl_parts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1" />

        <!-- ===================== decode ===================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_decode"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_pick_parts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_parts" />

        <TextView
            android:id="@+id/txt_decode_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="0 parts selected" />

        <Button
            android:id="@+id/btn_pick_out_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_out_file" />

        <TextView
            android:id="@+id/txt_out_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="restored.bin" />

        <Button
            android:id="@+id/btn_decode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/decode" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="idle" />

    </LinearLayout>
</ScrollView>
